{
  "name": "macro-diary",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Local-only food and weight diary for iPhone (PWA).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
